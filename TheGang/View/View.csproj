<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>TheGang</AssemblyName>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>1.0.0</Version>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Updates\Updates.csproj" />
      <ProjectReference Include="..\ViewModel\ViewModel.csproj" />
      <ProjectReference Include="..\Network\Network.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Assets\*.png" />
      <Resource Include="Assets\*.png" />
    </ItemGroup>

<ItemGroup><Compile Include="../Updates/UpdateProgressPanel.cs" Link="UpdateProgressPanel.cs" /></ItemGroup></Project>
