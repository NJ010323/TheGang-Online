                                     IsChecked="True" Style="{StaticResource SelectionChoice}"
                                     Click="WindowedMode_Click" />
                        <RadioButton x:Name="FullScreenOption" Content="Plein écran" GroupName="DisplayMode"
                                     Style="{StaticResource SelectionChoice}" Click="FullScreenMode_Click" />
                    </UniformGrid>
                    <TextBlock Text="EFFETS DE TABLE" Foreground="#F0C86A" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="Animation des nouvelles cartes et de la prochaine main à révéler."
                               Foreground="#C9BBA6" TextWrapping="Wrap" Margin="0,5,0,13" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="AnimationsOnOption" Content="Animés" GroupName="AnimationMode"
                                     IsChecked="True" Style="{StaticResource SelectionChoice}"
                                     Click="AnimationsOn_Click" />
                        <RadioButton x:Name="AnimationsOffOption" Content="Désactivés" GroupName="AnimationMode"
                                     Style="{StaticResource SelectionChoice}" Click="AnimationsOff_Click" />
                    </UniformGrid>
                    <StackPanel x:Name="GameSettingsSection" Visibility="Collapsed" Margin="0,25,0,0">
                        <TextBlock Text="PARTIE EN COURS" Foreground="#F0C86A"
                                   FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="ExitGameHint" Text="Quitter met fin à la partie pour tous les joueurs."
                                   Foreground="#C9BBA6" TextWrapping="Wrap" Margin="0,5,0,13" />
                        <Button Content="Quitter la partie" Style="{StaticResource TableDangerButton}"
                                HorizontalAlignment="Left" AutomationProperties.Name="Quitter la partie"
                                Click="ExitGame_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notification visible au centre en haut, sans masquer les commandes. -->
        <Border x:Name="NoticeBanner" Grid.RowSpan="2" Panel.ZIndex="30" Visibility="Collapsed"
                Background="#F3231B18" BorderBrush="#E5B958" BorderThickness="1.5"
                CornerRadius="11" Padding="18,13" MinWidth="420" MaxWidth="760"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NoticeIcon" Text="i" FontSize="24" FontWeight="Bold"
                           Foreground="#F0C86A" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="#FFF4DC"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}"
                        Width="36" Height="36" Padding="0" Margin="6,0,0,0"
                        AutomationProperties.Name="Fermer le message" Click="NoticeClose_Click" />
            </Grid>
        </Border>

        <!-- Résultat partagé par tous les joueurs après la résolution du braquage. -->
        <Grid x:Name="HeistOutcomeOverlay" Grid.RowSpan="2" Panel.ZIndex="40"
              Visibility="Collapsed" Background="#E8080708">
            <!-- Le débrief complet se réduit avec la fenêtre sans imposer de défilement. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="18">
                <Border x:Name="OutcomeCard" Width="865" Padding="25,20"
                        Background="#F0181112" BorderBrush="#E5B958" BorderThickness="2"
                        CornerRadius="18" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="OutcomeScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="OutcomeEyebrow" Text="BRAQUAGE" TextAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="#D7BA76" />
                        <Grid Margin="0,12,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="OutcomeTitle" TextAlignment="Center" Margin="0,0,0,7"
                                           FontFamily="Georgia" FontSize="29" FontWeight="Bold"
                                           TextWrapping="Wrap" Foreground="#F4D17D" />
                                <TextBlock x:Name="OutcomeSubtitle" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="295" FontSize="14" Foreground="#E9D9BF" />
                                <Grid Width="290" Height="255" Margin="0,8,0,0">
                                    <Ellipse x:Name="OutcomeGlow" Width="270" Height="235" Opacity="0"
                                             Fill="#A8E9AF3F" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect><BlurEffect Radius="75" /></Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="OutcomeAlarmGlow" Width="270" Height="235" Opacity="0"
                                             Fill="#DDF52925" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect><BlurEffect Radius="75" /></Ellipse.Effect>
                                    </Ellipse>
                                    <Image x:Name="OutcomeClosedImage" Source="Assets/vault-closed.png"
                                           Width="275" Height="250" Stretch="Uniform" />
                                    <Image x:Name="OutcomeOpenImage" Source="Assets/vault-open.png"
                                           Width="275" Height="250" Stretch="Uniform" Opacity="0" />
                                    <Image x:Name="OutcomeGoldImage" Width="290" Height="220"
                                           Stretch="Uniform" Visibility="Collapsed" Opacity="0"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform x:Name="OutcomeGoldScale" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <Image x:Name="OutcomeAlarmImage" Width="290" Height="220"
                                           Stretch="Uniform" Visibility="Collapsed" Opacity="0" />
                                </Grid>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="18,0,0,0" Padding="14"
                                    Background="#432824" BorderBrush="#96734E" BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="DÉBRIEF DU BRAQUAGE" FontFamily="Georgia"
                                               FontSize="20" FontWeight="Bold" Foreground="#F6D591" />
                                    <TextBlock x:Name="OutcomeDebriefSummary" TextWrapping="Wrap"
                                               FontSize="13" Foreground="#E8D7BB" Margin="0,8,0,10" />
                                    <Grid Margin="3,0,3,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="91" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="JETON" FontSize="9" Foreground="#CDB887" />
                                        <TextBlock Grid.Column="1" Text="JOUEUR" FontSize="9" Foreground="#CDB887" />
                                        <TextBlock Grid.Column="2" Text="MEILLEURE MAIN" FontSize="9" Foreground="#CDB887" />
                                        <TextBlock Grid.Column="3" Text="RANG" FontSize="9" Foreground="#CDB887" />
                                    </Grid>
                                    <StackPanel x:Name="OutcomeDebriefRowsPanel" />
                                    <TextBlock Text="Une égalité de force est acceptée. Les rangs égaux sont partagés."
                                               TextWrapping="Wrap" FontSize="11" Foreground="#BEA98D"
                                               Margin="1,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Content="Revenir à la table" AutomationProperties.Name="Fermer le débrief du braquage"
                                Style="{StaticResource TableActionButton}" Width="210" Margin="0"
                                HorizontalAlignment="Center" Click="CloseHeistOutcome_Click" />
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- Règles illustrées, accessibles depuis le menu et depuis la carte voisine de la main. -->
        <Grid x:Name="RulesOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Visibility="Collapsed"
              Background="#EC080708">
            <Border MaxWidth="1120" MaxHeight="760" Margin="24" Padding="24"
                    Background="#1D1415" BorderBrush="#D5A95C" BorderThickness="2"
                    CornerRadius="17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="RÈGLES DU JEU  ·  THE GANG" FontFamily="Georgia"
                                   FontSize="27" FontWeight="Bold" Foreground="#F5D17B"
                                   VerticalAlignment="Center" />
                        <Button Content="Fermer" Style="{StaticResource TableButton}"
                                HorizontalAlignment="Right" Margin="0"
                                Click="CloseRulesCard_Click" />
                    </Grid>
                    <!-- Le panneau entier se réduit avec la fenêtre : les dix mains restent visibles sans défilement. -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                        <Grid Width="1010" Height="680">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#F3E6D1" BorderBrush="#B58C53" BorderThickness="2"
                                    CornerRadius="10" Padding="18"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="VOTRE MISSION" Foreground="#3E2721"
                                               FontSize="22" FontWeight="Bold" FontFamily="Georgia" />
                                    <TextBlock Text="De 3 à 6 joueurs, classez vos mains de la plus faible à la plus forte. Chacun a deux cartes privées ; les cartes communes servent à tous."
                                               Foreground="#49352A" FontSize="16" TextWrapping="Wrap"
                                               Margin="0,8,0,9" />
                                    <StackPanel x:Name="RuleRoundsPanel" />
                                    <TextBlock Text="JETONS ET ACCORD" Foreground="#622C24" FontSize="17"
                                               FontWeight="Bold" Margin="0,6,0,5" />
                                    <TextBlock Text="À chaque tour, prenez un jeton au centre : 1 pour la main supposée la plus faible, le plus grand pour la plus forte. Vous pouvez rendre ou reprendre un jeton."
                                               Foreground="#49352A" TextWrapping="Wrap" FontSize="15" />
                                    <TextBlock Text="Quand chacun a un jeton, confirmez. Tout échange annule l'accord ; l'hôte passe à la suite après la confirmation de tous."
                                               Foreground="#49352A" TextWrapping="Wrap" FontSize="15"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="RÉVÉLATION" Foreground="#622C24" FontSize="17"
                                               FontWeight="Bold" Margin="0,8,0,5" />
                                    <TextBlock Text="Après l'accord sur les jetons rouges, les mains se dévoilent de 1 à N. Elles doivent être de plus en plus fortes ; les égalités passent. Une erreur déclenche une alarme."
                                               Foreground="#49352A" TextWrapping="Wrap" FontSize="15" />
                                    <TextBlock Text="OUVRIR LE COFFRE" Foreground="#622C24" FontSize="17"
                                               FontWeight="Bold" Margin="0,8,0,5" />
                                    <TextBlock Text="Retournez trois cartes d'or pour gagner. Trois alarmes mettent fin à la partie."
                                               Foreground="#49352A" TextWrapping="Wrap" FontSize="15" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F3E6D1" BorderBrush="#B58C53"
                                    BorderThickness="2" CornerRadius="10" Padding="14" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CLASSEMENT DES MAINS" Foreground="#3E2721"
                                               FontSize="22" FontWeight="Bold" FontFamily="Georgia" />
                                    <TextBlock Text="De la plus forte à la plus faible"
                                               Foreground="#65493B" FontSize="16" Margin="0,4,0,8" />
                                    <StackPanel x:Name="PokerHandRowsPanel" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- La session reste en mémoire pendant les tentatives ; aucun nouveau code n'est nécessaire. -->
        <Grid x:Name="ReconnectOverlay" Grid.RowSpan="2" Panel.ZIndex="60"
              Visibility="Collapsed" Background="#DC080709">
            <Border Width="540" MaxWidth="540" Padding="30,26" Margin="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#23191C" BorderBrush="#D6A95F" BorderThickness="2"
                    CornerRadius="15">
                <StackPanel>
                    <TextBlock Text="◈  CONNEXION INTERROMPUE  ◈" FontFamily="Georgia"
                               FontSize="25" FontWeight="Bold" Foreground="#F5D17B"
                               TextAlignment="Center" />
                    <Border Height="1" Background="#8F6940" Margin="20,17" />
                    <TextBlock Text="Reconnexion automatique à la partie en cours…"
                               FontSize="17" FontWeight="SemiBold" Foreground="#FFF0D8"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReconnectStatusText" FontSize="13" Foreground="#C9BBA6"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="8,13,8,21" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Réessayer maintenant" Style="{StaticResource TableButton}"
                                Margin="0,0,10,0" Click="RetryConnection_Click" />
                        <Button Content="Quitter la table" Style="{StaticResource TableDangerButton}"
                                Margin="0" Click="LeaveDuringReconnect_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- La pause est commune à toute la table ; le décompte vient du serveur de l'hôte. -->
        <Grid x:Name="PausedGameOverlay" Grid.RowSpan="2" Panel.ZIndex="51"
              Visibility="Collapsed" Background="#D9080708">
            <Border Width="590" Padding="32,28" Margin="18" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#271A1C" BorderBrush="#E0AC62"
                    BorderThickness="2" CornerRadius="15">
                <StackPanel>
                    <TextBlock x:Name="PausedTitleText" Text="◈  PARTIE EN PAUSE  ◈" FontFamily="Georgia" FontSize="28"
                               FontWeight="Bold" Foreground="#F5D17B" TextAlignment="Center" />
                    <Border Height="1" Background="#9B7144" Margin="18,18" />
                    <TextBlock x:Name="PausedPlayerText" FontSize="19" FontWeight="SemiBold"
                               Foreground="#FFF0D8" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="PausedExplanationText" Text="Les cartes et les jetons restent en place. La partie reprendra dès son retour."
                               FontSize="15" Foreground="#D7C8B1" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="15,14,15,8" />
                    <TextBlock x:Name="PauseDeadlineText" FontSize="15" Foreground="#F1C777"
                               TextAlignment="Center" Margin="0,4,0,0" />
                    <Button Content="Paramètres" Style="{StaticResource TableButton}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Click="Settings_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confirmation commune aux sorties du lobby, de la partie et de l'application. -->
        <Grid x:Name="ExitConfirmationOverlay" Grid.RowSpan="2" Panel.ZIndex="70"
              Visibility="Collapsed" Background="#E6090709">
            <Border Width="560" Padding="30,27" Margin="18" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#281B1D" BorderBrush="#D7A85E"
                    BorderThickness="2" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="THE GANG  ·  DÉCISION FINALE" Foreground="#D7A85E"
                               FontSize="13" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock x:Name="ExitConfirmationTitle" Text="ABANDONNER LA MISSION ?"
                               FontFamily="Georgia" FontSize="27" FontWeight="Bold"
                               Foreground="#F5D17B" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,14,0,0" />
                    <Border Height="1" Background="#957047" Margin="36,19" />
                    <TextBlock x:Name="ExitConfirmationQuestion"
                               Text="Voulez-vous abandonner votre mission ?"
                               Foreground="#FFF0D8" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExitConfirmationDetail" Foreground="#D6C4AD"
                               FontSize="15" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="10,12,10,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CancelExitButton" Content="Rester à la table" Style="{StaticResource TableButton}"
                                Width="180" Margin="0,0,12,0" IsCancel="True"
                                Click="CancelExit_Click" />
                        <Button x:Name="ConfirmExitButton" Content="Quitter"
                                Style="{StaticResource TableDangerButton}" Width="190" Margin="0"
                                Click="ConfirmExit_Click" />
                    </StackPanel>
                    <Button x:Name="ForceExitButton" Content="Quitter sans relève"
                            Style="{StaticResource QuietButton}" HorizontalAlignment="Center"
                            Margin="0,16,0,0" Visibility="Collapsed" Click="ForceExit_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Le successeur peut refuser : aucun tunnel n'est remplacé avant son accord. -->
        <Grid x:Name="MigrationOfferOverlay" Grid.RowSpan="2" Panel.ZIndex="76"
              Visibility="Collapsed" Background="#E6090709">
            <Border Width="600" Padding="32,28" Margin="18" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#281B1D" BorderBrush="#D7A85E"
                    BorderThickness="2" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="THE GANG  ·  RELÈVE DE L'ÉQUIPE" Foreground="#D7A85E"
                               FontSize="13" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="PRENDRE LA RELÈVE ?" FontFamily="Georgia" FontSize="29"
                               FontWeight="Bold" Foreground="#F5D17B" TextAlignment="Center"
                               Margin="0,16,0,0" />
                    <Border Height="1" Background="#957047" Margin="36,18" />
                    <TextBlock x:Name="MigrationOfferText" Foreground="#FFF0D8" FontSize="17"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="4,0,4,16" />
                    <TextBlock x:Name="MigrationOfferExplanation" Text="Le braquage en cours sera redistribué. Les cartes d'or et les alarmes déjà obtenues seront conservées."
                               Foreground="#D6C4AD" FontSize="14" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="8,0,8,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Refuser" Style="{StaticResource TableButton}"
                                Width="170" Height="60" Margin="0,0,12,0" Click="DeclineMigration_Click" />
                        <Button Style="{StaticResource MigrationAcceptButton}" Click="AcceptMigration_Click"
                                AutomationProperties.Name="Devenir hôte">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="DEVENIR HÔTE" FontSize="16" TextAlignment="Center" />
                                <TextBlock Text="PRENDRE LA RELÈVE" FontFamily="Segoe UI" FontSize="9"
                                           FontWeight="SemiBold" TextAlignment="Center"
                                           Opacity="0.82" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Une étape lisible pendant la création du tunnel et la redirection des invités. -->
        <Grid x:Name="MigrationProgressOverlay" Grid.RowSpan="2" Panel.ZIndex="77"
              Visibility="Collapsed" Background="#E6090709">
            <Border Width="590" Padding="32,28" Margin="18" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#281B1D" BorderBrush="#D7A85E"
                    BorderThickness="2" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="◈  PASSAGE DE RELAIS  ◈" FontFamily="Georgia" FontSize="28"
                               FontWeight="Bold" Foreground="#F5D17B" TextAlignment="Center" />
                    <Border Height="1" Background="#957047" Margin="36,18" />
                    <TextBlock x:Name="MigrationProgressText" Foreground="#FFF0D8" FontSize="17"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="5,0,5,18" />
                    <Button x:Name="CancelMigrationButton" Content="Annuler la relève"
                            Style="{StaticResource TableButton}" HorizontalAlignment="Center"
                            Click="CancelMigration_Click" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
