<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Gang" Width="1440" Height="900" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0D0909" Foreground="#F8EDD9"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp" LostMouseCapture="Window_LostMouseCapture">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E5B958" />
            <Setter Property="Foreground" Value="#22130F" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="#FFF0CE84" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#FFE3A2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#332A25" />
            <Setter Property="Foreground" Value="#F6E9CF" />
        </Style>
        <!-- Commandes du plateau : même cadre art déco, couleurs distinctes selon l'action. -->
        <Style x:Key="TableButton" TargetType="Button">
            <Setter Property="Background" Value="#302326" />
            <Setter Property="BorderBrush" Value="#A98557" />
            <Setter Property="Foreground" Value="#F8EBD4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverWash" Background="#88FFF2D6"
                                        CornerRadius="8" Opacity="0" />
                                <Border Height="1" Margin="10,3,10,0" VerticalAlignment="Top"
                                        Background="#7EFFE9AD" />
                                <Border Height="1" Margin="10,0,10,3" VerticalAlignment="Bottom"
                                        Background="#85200E12" />
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◆" FontSize="7" Opacity="0.7" Margin="0,0,8,0"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                    <TextBlock Grid.Column="2" Text="◆" FontSize="7" Opacity="0.7"
                                               Margin="8,0,0,0" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.24" />
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FFE3A3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.42" />
                                <Setter TargetName="ButtonShell" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableActionButton" TargetType="Button" BasedOn="{StaticResource TableButton}">
            <Setter Property="Foreground" Value="#29160F" />
            <Setter Property="BorderBrush" Value="#FFE2A0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F7DB91" Offset="0" />
                        <GradientStop Color="#D9A34D" Offset="0.56" />
                        <GradientStop Color="#B98339" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableDangerButton" TargetType="Button" BasedOn="{StaticResource TableButton}">
            <Setter Property="Foreground" Value="#F7D4CA" />
            <Setter Property="BorderBrush" Value="#B66B61" />
            <Setter Property="Background" Value="#4A2024" />
        </Style>
        <!-- Petite commande utilisée sur le bord du tableau des jetons. -->
        <Style x:Key="HistoryTabButton" TargetType="Button">
            <Setter Property="Background" Value="#302326" />
            <Setter Property="Foreground" Value="#F8EBD4" />
            <Setter Property="BorderBrush" Value="#A98557" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="#503438" />
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#F0C86A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EntryBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1414" />
            <Setter Property="Foreground" Value="#FFF4DF" />
            <Setter Property="CaretBrush" Value="#F0C86A" />
            <Setter Property="SelectionBrush" Value="#D4A64D" />
            <Setter Property="BorderBrush" Value="#967347" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,7,0,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputFrame" Property="BorderBrush" Value="#F4C969" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputFrame" Property="Background" Value="#2B2020" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Boutons segmentés partagés par la capacité du lobby et les paramètres. -->
        <Style x:Key="SelectionChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F4E5CA" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceFrame" Background="#2A1D1C" BorderBrush="#8C6943"
                                BorderThickness="1.5" CornerRadius="9" Padding="13,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#F1C66A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="Background" Value="#E5B958" />
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#FFDF89" />
                                <Setter Property="Foreground" Value="#21130E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre commune à l'accueil, au lobby et à la partie. -->
        <Grid Grid.Row="0" Background="#080707">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/logo-reference.png" Width="184" Height="58" Stretch="None"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="POKER COOPÉRATIF  ·  BRAQUAGE EN ÉQUIPE" Foreground="#F1C975"
                           FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="Trois cartes d'or pour ouvrir le coffre" Foreground="#BBAA8E"
                           FontSize="11" TextAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="⚙  Paramètres" AutomationProperties.Name="Ouvrir les paramètres"
                    Style="{StaticResource TableButton}" Margin="0,12,18,2" Click="Settings_Click" />
        </Grid>

        <!-- Menu principal. -->
        <Grid x:Name="MenuPanel" Grid.Row="1">
            <Image Source="Assets/table-felt.png" Stretch="UniformToFill" Opacity="0.72" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#EC100A0B" Offset="0" />
                        <GradientStop Color="#A5100A0B" Offset="0.55" />
                        <GradientStop Color="#25100A0B" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Margin="80,50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="530" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="UN BRAQUAGE. UNE SEULE ÉQUIPE." Foreground="#F0C86A"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,18" />
                    <TextBlock Text="Lisez vos cartes.&#10;Classez vos forces.&#10;Gagnez ensemble."
                               FontSize="40" FontFamily="Georgia" FontWeight="Bold" LineHeight="54"
                               TextWrapping="Wrap" Margin="0,0,0,25" />
                    <TextBlock Text="De 3 à 6 joueurs. Créez un lobby, partagez l'invitation et prenez place autour de la table."
                               Foreground="#DFD0BC" FontSize="17" TextWrapping="Wrap" Width="465"
                               HorizontalAlignment="Left" Margin="0,0,0,32" />
                    <Button Content="Héberger une partie" Width="270" HorizontalAlignment="Left"
                            Style="{StaticResource ActionButton}" Click="HostMenu_Click" />
                    <Button Content="Rejoindre une partie" Width="270" HorizontalAlignment="Left"
                            Style="{StaticResource QuietButton}" Click="JoinMenu_Click" />
                    <Button Content="Quitter le jeu" Width="270" HorizontalAlignment="Left"
                            Style="{StaticResource QuietButton}" Click="Quit_Click" />
                </StackPanel>
                <Grid Grid.Column="1" Width="500" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/card-back.png" Width="205" Height="310" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="-115,5,0,0">
                        <Image.RenderTransform><RotateTransform Angle="-15" CenterX="100" CenterY="150" /></Image.RenderTransform>
                    </Image>
                    <Image Source="Assets/card-back.png" Width="205" Height="310" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="115,-5,0,0">
                        <Image.RenderTransform><RotateTransform Angle="13" CenterX="100" CenterY="150" /></Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>
        </Grid>

        <!-- Choix hôte/invité avant ouverture de la connexion. -->
        <Grid x:Name="EntryPanel" Grid.Row="1" Visibility="Collapsed">
            <Image Source="Assets/table-felt.png" Stretch="UniformToFill" Opacity="0.36" />
            <Border Width="560" Padding="40" Background="#E9161012" BorderBrush="#8B7048"
                    BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EntryTitle" Text="Héberger une partie" FontSize="31"
                               FontFamily="Georgia" FontWeight="Bold" Foreground="#F6D17C" Margin="0,0,0,9" />
                    <TextBlock x:Name="EntrySubtitle" Text="Choisissez votre pseudo et la taille de la table."
                               Foreground="#CFC0A9" FontSize="15" Margin="0,0,0,30" />
                    <TextBlock Text="VOTRE PSEUDO" Foreground="#E0C78A" FontWeight="SemiBold" />
                    <TextBox x:Name="NicknameBox" Style="{StaticResource EntryBox}" MaxLength="24" />
                    <StackPanel x:Name="HostSetup">
                        <TextBlock Text="NOMBRE MAXIMAL DE JOUEURS" Foreground="#E0C78A" FontWeight="SemiBold" />
                        <TextBlock Text="Choisissez la taille de la table, hôte compris."
                                   Foreground="#BBAE9C" FontSize="13" Margin="0,5,0,12" />
                        <UniformGrid Columns="4" Margin="0,0,0,25">
                            <RadioButton x:Name="Players3Option" Content="3" GroupName="LobbyCapacity"
                                         IsChecked="True" Style="{StaticResource SelectionChoice}" />
                            <RadioButton x:Name="Players4Option" Content="4" GroupName="LobbyCapacity"
                                         Style="{StaticResource SelectionChoice}" />
                            <RadioButton x:Name="Players5Option" Content="5" GroupName="LobbyCapacity"
                                         Style="{StaticResource SelectionChoice}" />
                            <RadioButton x:Name="Players6Option" Content="6" GroupName="LobbyCapacity"
                                         Style="{StaticResource SelectionChoice}" />
                        </UniformGrid>
                        <Button x:Name="CreateButton" Content="Créer le lobby" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Width="230" Click="Create_Click" />
                    </StackPanel>
                    <StackPanel x:Name="JoinSetup" Visibility="Collapsed">
                        <TextBlock Text="INVITATION REÇUE" Foreground="#E0C78A" FontWeight="SemiBold" />
                        <TextBox x:Name="InvitationInput" Style="{StaticResource EntryBox}" />
                        <Button x:Name="JoinButton" Content="Rejoindre la table" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Width="230" Click="Join_Click" />
                    </StackPanel>
                    <Button Content="← Retour au menu" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Margin="0,22,0,0" Click="BackMenu_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lobby avant départ. -->
        <Grid x:Name="LobbyPanel" Grid.Row="1" Visibility="Collapsed">
            <Image Source="Assets/table-felt.png" Stretch="UniformToFill" Opacity="0.43" />
            <Grid Margin="60,35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,35,0">
                    <TextBlock Text="SALON DE JEU" Foreground="#E6BF69" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="En attente des joueurs" FontSize="36" FontFamily="Georgia"
                               FontWeight="Bold" Margin="0,10,0,20" />
                    <TextBlock x:Name="LobbyDetails" FontSize="18" Foreground="#E7D6B9" Margin="0,0,0,22" />
                    <TextBlock Text="INVITATION À PARTAGER" Foreground="#E6BF69" FontWeight="Bold" />
                    <TextBox x:Name="InvitationOutput" Style="{StaticResource EntryBox}" IsReadOnly="True" />
                    <WrapPanel>
                        <Button Content="Copier l'invitation" Style="{StaticResource ActionButton}" Click="Copy_Click" />
                        <Button x:Name="StartButton" Content="Lancer la partie" Style="{StaticResource ActionButton}"
                                Click="Start_Click" />
                        <Button x:Name="LeaveButton" Content="Quitter le lobby" Style="{StaticResource QuietButton}"
                                Click="Leave_Click" />
                    </WrapPanel>
                    <TextBlock Text="La partie commence dès que l'hôte lance le jeu avec au moins trois joueurs."
                               TextWrapping="Wrap" Foreground="#BBAE9C" Margin="0,18,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#D9141011" BorderBrush="#8B7048"
                        BorderThickness="1" CornerRadius="12" Padding="25" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="AUTOUR DE LA TABLE" Foreground="#F0C86A" FontSize="17"
                                   FontWeight="Bold" Margin="0,0,0,16" />
                        <ListBox x:Name="PlayersList" Height="300" Background="Transparent" Foreground="#F8EDD9"
                                 BorderThickness="0" FontSize="19" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Plateau et tableau des choix. -->
        <Grid x:Name="GamePanel" Grid.Row="1" Visibility="Collapsed" Background="#100A0B">
            <Grid.RowDefinitions>
                <RowDefinition Height="112" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="22,3,22,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="GamePhaseText" FontSize="21" FontFamily="Georgia" FontWeight="Bold"
                               Foreground="#F0C86A" VerticalAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Left" MaxWidth="370" />
                    <TextBlock Text="RÉSULTATS DES BRAQUAGES" Foreground="#CBA665"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <!-- Deux séries de trois cartes retournables, assez grandes pour identifier l'or et l'alarme. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="#38291A" BorderBrush="#A9823E" BorderThickness="1"
                            CornerRadius="8" Padding="7,3" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="GoldCountText" Text="OR  0/3" Foreground="#FFE19A"
                                       FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <StackPanel x:Name="GoldResultCardsPanel" Orientation="Horizontal" />
                        </StackPanel>
                    </Border>
                    <Border Background="#342023" BorderBrush="#A55B54" BorderThickness="1"
                            CornerRadius="8" Padding="7,3">
                        <StackPanel>
                            <TextBlock x:Name="AlarmCountText" Text="ALARMES  0/3" Foreground="#FF9990"
                                       FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <StackPanel x:Name="AlarmResultCardsPanel" Orientation="Horizontal" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="HistoryColumn" Width="306" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#806441" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="1280" Height="720" Background="#180808">
                            <Image Source="Assets/table-felt.png" Width="1280" Height="720" Stretch="Fill" />
                            <TextBlock Text="CARTES COMMUNES" Foreground="#DDC187" FontSize="18"
                                       FontWeight="Bold" Canvas.Left="530" Canvas.Top="282" />
                            <StackPanel x:Name="CommunityCardsPanel" Orientation="Horizontal"
                                        Canvas.Left="425" Canvas.Top="318" />
                            <TextBlock x:Name="TablePhaseText" Foreground="#E6C37D" FontSize="18"
                                       TextAlignment="Center" Width="560" Canvas.Left="360" Canvas.Top="442" />
                            <TextBlock x:Name="TokenBankTitle" Text="JETONS DU TOUR · GLISSEZ VERS VOTRE MAIN"
                                       Foreground="#E8C879" FontSize="13" FontWeight="Bold"
                                       Width="600" TextAlignment="Center" Canvas.Left="340" Canvas.Top="482" />
                            <StackPanel x:Name="TokenBankPanel" Orientation="Horizontal"
                                        Canvas.Top="506" />
                            <Canvas x:Name="SeatsCanvas" Width="1280" Height="720" />
                            <!-- Carte d'aide conservée à côté de la main du joueur local. -->
                            <Button x:Name="RulesCardButton" Canvas.Left="778" Canvas.Top="550"
                                    Width="128" Height="140" Cursor="Hand"
                                    AutomationProperties.Name="Agrandir la carte des règles"
                                    Click="OpenRulesCard_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RulesFrame" CornerRadius="8" Background="#D6AC61"
                                                BorderBrush="#FFDB89" BorderThickness="2" Padding="3">
                                            <Border x:Name="RulesInset" CornerRadius="4" Background="#F4E7D0"
                                                    BorderBrush="#904B32" BorderThickness="1" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RulesFrame" Property="BorderBrush" Value="White" />
                                                <Setter TargetName="RulesInset" Property="Background" Value="#FFF2D9" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="RulesFrame" Property="BorderBrush" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Width="106">
                                    <TextBlock Text="✦  AIDE DE JEU  ✦" Foreground="#75322B" FontSize="11"
                                               FontWeight="Bold" TextAlignment="Center" />
                                    <Grid Height="56" Margin="0,2,0,1">
                                        <TextBlock Text="♠" Foreground="#251F26" FontSize="48"
                                                   TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="♥" Foreground="#B82432" FontSize="22"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,18,1" />
                                    </Grid>
                                    <TextBlock Text="10 COMBINAISONS" Foreground="#3D2924" FontSize="10"
                                               FontWeight="Bold" TextAlignment="Center" />
                                    <Border Height="22" Background="#69342B" CornerRadius="2"
                                            Margin="0,5,0,0">
                                        <TextBlock Text="AGRANDIR  ↗" Foreground="#FFE9C9" FontSize="10"
                                                   FontWeight="Bold" TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Canvas x:Name="ChipFlightCanvas" Width="1280" Height="720"
                                    IsHitTestVisible="False" />
                            <!-- L'annonce de phase reste sur le tapis pendant le retournement des cartes. -->
                            <Grid x:Name="RoundTransitionOverlay" Width="1280" Height="720"
                                  Visibility="Collapsed" IsHitTestVisible="False"
                                  Background="#760B0709">
                                <Border x:Name="RoundTransitionCard" Width="575" Padding="30,23"
                                        Background="#F21B1114" BorderBrush="#E5B958"
                                        BorderThickness="2" CornerRadius="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,100,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RoundTransitionScale" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="RoundTransitionEyebrow" Text="TOUR TERMINÉ"
                                                   TextAlignment="Center" Foreground="#D7B97A"
                                                   FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="RoundTransitionTitle" TextAlignment="Center"
                                                   FontFamily="Georgia" FontSize="31" FontWeight="Bold"
                                                   Foreground="#F6D17C" Margin="0,9,0,7" />
                                        <TextBlock x:Name="RoundTransitionDetail" TextAlignment="Center"
                                                   Foreground="#F0DFC6" FontSize="18" />
                                        <Border Height="5" Background="#594B372B" CornerRadius="3"
                                                Margin="0,20,0,0">
                                            <Border x:Name="RoundTransitionProgress" Background="#E5B958"
                                                    CornerRadius="3" HorizontalAlignment="Stretch"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="RoundTransitionProgressScale" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border x:Name="HistoryPanel" Grid.Column="1" Background="#E3161012" BorderBrush="#806441"
                        BorderThickness="1" CornerRadius="10" Margin="12,0,0,0" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock Text="TABLEAU DES JETONS" FontSize="16" FontWeight="Bold"
                                           Foreground="#F0C86A" VerticalAlignment="Center" />
                                <Button x:Name="HistoryHideButton" Width="34" Height="30"
                                        HorizontalAlignment="Right" Padding="0"
                                        Style="{StaticResource HistoryTabButton}"
                                        ToolTip="Masquer le tableau des jetons"
                                        AutomationProperties.Name="Masquer le tableau des jetons"
                                        Click="HistoryToggle_Click">
                                    <Path Data="M 3,2 L 9,8 L 3,14" Width="12" Height="16"
                                          Stroke="#F8EBD4" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Stretch="None" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Choix de chaque joueur, tour par tour"
                                       Foreground="#BBAE9C" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border x:Name="ActivityPanel" DockPanel.Dock="Bottom"
                                BorderBrush="#725636" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="ACTIONS RÉCENTES" FontSize="13" FontWeight="Bold"
                                           Foreground="#F0C86A" Margin="0,0,0,8" />
                                <StackPanel x:Name="ActivityRowsPanel" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Classement progressif des mains déjà dévoilées ; les autres attendent en bas. -->
                                <Border x:Name="ShowdownResultsPanel" Visibility="Collapsed"
                                        Background="#342023" BorderBrush="#AA7655" BorderThickness="1"
                                        CornerRadius="8" Padding="7" Margin="0,0,0,9">
                                    <StackPanel>
                                        <TextBlock Text="CLASSEMENT DES MAINS" Foreground="#F8D48A"
                                                   FontFamily="Georgia" FontSize="14" FontWeight="Bold"
                                                   Margin="1,1,0,2" />
                                        <TextBlock x:Name="ShowdownProgressText" Foreground="#BFA991"
                                                   FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Margin="1,0,0,6" />
                                        <StackPanel x:Name="ShowdownRowsPanel" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="HistorySubheading" Text="HISTORIQUE DES JETONS"
                                           Visibility="Collapsed" Foreground="#CBA665"
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />
                                <StackPanel x:Name="HistoryRowsPanel" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Button x:Name="HistoryShowButton" Grid.Column="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                        Visibility="Collapsed" Style="{StaticResource HistoryTabButton}"
                        ToolTip="Afficher les jetons de tous les joueurs"
                        AutomationProperties.Name="Afficher le tableau des jetons"
                        Click="HistoryToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 9,2 L 3,8 L 9,14" Width="12" Height="16"
                              Stroke="#F8EBD4" StrokeThickness="2" Margin="0,0,7,0"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="None" />
                        <TextBlock Text="Tableau des jetons" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="2" Height="116" Background="#211515" BorderBrush="#665032"
                    BorderThickness="0,1,0,0" Padding="18,8">
                <!-- Les deux rangées gardent la même hauteur pour l'hôte et les invités. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="49" />
                        <RowDefinition Height="49" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="TokenActions" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GLISSEZ UN JETON VERS VOTRE MAIN"
                                   Foreground="#E9C575" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold" TextWrapping="Wrap"
                                   Margin="0,0,12,0" />
                        <Button x:Name="ReturnTokenButton" Grid.Column="1" Content="Rendre"
                                Style="{StaticResource TableButton}" Margin="0,3,7,3"
                                Click="ReturnToken_Click" />
                        <Button x:Name="ConfirmButton" Grid.Column="2" Content="Confirmer mon choix"
                                Style="{StaticResource TableActionButton}" Margin="0,3,7,3"
                                Click="Confirm_Click" />
                        <Button x:Name="WithdrawButton" Grid.Column="3" Content="Retirer ma confirmation"
                                Style="{StaticResource TableButton}" Margin="0,3,0,3"
                                Click="Withdraw_Click" />
                    </Grid>
                    <TextBlock x:Name="FooterPhaseHint" Grid.Row="0" TextAlignment="Center"
                               Foreground="#E9D5AE" FontSize="14" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="FooterHostHint" Grid.Row="1" TextAlignment="Center"
                               Foreground="#BAA68B" FontSize="13" VerticalAlignment="Center" />
                    <StackPanel x:Name="HostActions" Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="AdvanceButton" Content="Révéler le tour suivant"
                                Style="{StaticResource TableActionButton}" Margin="0,2,0,2" Click="Advance_Click" />
                        <Button x:Name="RevealButton" Content="Révéler la prochaine main"
                                Style="{StaticResource TableActionButton}" Margin="0,2,0,2" Click="Reveal_Click" />
                        <Button x:Name="ResolveButton" Content="Résoudre le braquage"
                                Style="{StaticResource TableActionButton}" Margin="0,2,0,2" Click="Resolve_Click" />
                        <Button x:Name="NextHeistButton" Content="Braquage suivant"
                                Style="{StaticResource TableActionButton}" Margin="0,2,0,2" Click="NextHeist_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Panneau modal des réglages, disponible depuis tous les écrans. -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
              Background="#D0080708">
            <Border Width="570" Padding="35" Background="#191112" BorderBrush="#A8874C"
                    BorderThickness="1.5" CornerRadius="16" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,22">
                        <TextBlock Text="Paramètres" FontFamily="Georgia" FontWeight="Bold" FontSize="32"
                                   Foreground="#F4CE75" VerticalAlignment="Center" />
                        <Button Content="Fermer" Style="{StaticResource TableButton}"
                                HorizontalAlignment="Right" Margin="0" Click="CloseSettings_Click" />
                    </Grid>
                    <TextBlock Text="AFFICHAGE" Foreground="#F0C86A" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="Choisissez comment afficher la table. F11 permet aussi de changer de mode."
                               Foreground="#C9BBA6" TextWrapping="Wrap" Margin="0,5,0,13" />
                    <UniformGrid Columns="2" Margin="0,0,0,28">
                        <RadioButton x:Name="WindowedOption" Content="Fenêtré" GroupName="DisplayMode"
                                     IsChecked="True" Style="{StaticResource SelectionChoice}"
                                     Click="WindowedMode_Click" />
                        <RadioButton x:Name="FullScreenOption" Content="Plein écran" GroupName="DisplayMode"
                                     Style="{StaticResource SelectionChoice}" Click="FullScreenMode_Click" />
                    </UniformGrid>
                    <TextBlock Text="EFFETS DE TABLE" Foreground="#F0C86A" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="Animation des nouvelles cartes et de la prochaine main à révéler."
                               Foreground="#C9BBA6" TextWrapping="Wrap" Margin="0,5,0,13" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="AnimationsOnOption" Content="Animés" GroupName="AnimationMode"
                                     IsChecked="True" Style="{StaticResource SelectionChoice}"
                                     Click="AnimationsOn_Click" />
                        <RadioButton x:Name="AnimationsOffOption" Content="Désactivés" GroupName="AnimationMode"
                                     Style="{StaticResource SelectionChoice}" Click="AnimationsOff_Click" />
                    </UniformGrid>
                    <StackPanel x:Name="GameSettingsSection" Visibility="Collapsed" Margin="0,25,0,0">
                        <TextBlock Text="PARTIE EN COURS" Foreground="#F0C86A"
                                   FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="Quitter met fin à la partie pour tous les joueurs."
                                   Foreground="#C9BBA6" TextWrapping="Wrap" Margin="0,5,0,13" />
                        <Button Content="Quitter la partie" Style="{StaticResource TableDangerButton}"
                                HorizontalAlignment="Left" AutomationProperties.Name="Quitter la partie"
                                Click="ExitGame_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notification visible au centre en haut, sans masquer les commandes. -->
        <Border x:Name="NoticeBanner" Grid.RowSpan="2" Panel.ZIndex="30" Visibility="Collapsed"
                Background="#F3231B18" BorderBrush="#E5B958" BorderThickness="1.5"
                CornerRadius="11" Padding="18,13" MinWidth="420" MaxWidth="760"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NoticeIcon" Text="i" FontSize="24" FontWeight="Bold"
                           Foreground="#F0C86A" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="#FFF4DC"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}"
                        Width="36" Height="36" Padding="0" Margin="6,0,0,0"
                        AutomationProperties.Name="Fermer le message" Click="NoticeClose_Click" />
            </Grid>
        </Border>

        <!-- Résultat partagé par tous les joueurs après la résolution du braquage. -->
        <Grid x:Name="HeistOutcomeOverlay" Grid.RowSpan="2" Panel.ZIndex="40"
              Visibility="Collapsed" Background="#E8080708">
            <Border x:Name="OutcomeCard" Width="600" MaxHeight="760" Padding="35,24"
                    Background="#F0181112" BorderBrush="#E5B958" BorderThickness="2"
                    CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OutcomeScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="OutcomeEyebrow" Text="BRAQUAGE" TextAlignment="Center"
                               FontSize="15" FontWeight="Bold" Foreground="#D7BA76" />
                    <TextBlock x:Name="OutcomeTitle" TextAlignment="Center" Margin="0,9,0,6"
                               FontFamily="Georgia" FontSize="35" FontWeight="Bold"
                               Foreground="#F4D17D" />
                    <TextBlock x:Name="OutcomeSubtitle" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="500" FontSize="16" Foreground="#E9D9BF" />
                    <Grid Width="370" Height="350" Margin="0,3,0,0">
                        <Ellipse x:Name="OutcomeGlow" Width="320" Height="290" Opacity="0"
                                 Fill="#A8E9AF3F" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="85" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="OutcomeAlarmGlow" Width="310" Height="270" Opacity="0"
                                 Fill="#DDF52925" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="80" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image x:Name="OutcomeClosedImage" Source="Assets/vault-closed.png"
                               Width="340" Height="340" Stretch="Uniform" />
                        <Image x:Name="OutcomeOpenImage" Source="Assets/vault-open.png"
                               Width="340" Height="340" Stretch="Uniform" Opacity="0" />
                        <Image x:Name="OutcomeGoldImage" Width="360" Height="240"
                               Stretch="Uniform" Visibility="Collapsed" Opacity="0"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="OutcomeGoldScale" />
                            </Image.RenderTransform>
                        </Image>
                        <Image x:Name="OutcomeAlarmImage" Width="360" Height="240"
                               Stretch="Uniform" Visibility="Collapsed" Opacity="0" />
                    </Grid>
                    <TextBlock x:Name="OutcomeScore" TextAlignment="Center" FontSize="15"
                               Foreground="#CBBDA8" Margin="0,0,0,18" />
                    <Button Content="Continuer" AutomationProperties.Name="Fermer le résultat du braquage"
                            Style="{StaticResource TableActionButton}" Width="200" Margin="0"
                            HorizontalAlignment="Center" Click="CloseHeistOutcome_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Aide illustrée de la partie, ouverte depuis la carte voisine de la main locale. -->
        <Grid x:Name="RulesOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Visibility="Collapsed"
              Background="#EC080708">
            <Border MaxWidth="1120" MaxHeight="760" Margin="24" Padding="24"
                    Background="#1D1415" BorderBrush="#D5A95C" BorderThickness="2"
                    CornerRadius="17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="CARTE D'AIDE  ·  THE GANG" FontFamily="Georgia"
                                   FontSize="27" FontWeight="Bold" Foreground="#F5D17B"
                                   VerticalAlignment="Center" />
                        <Button Content="Fermer" Style="{StaticResource TableButton}"
                                HorizontalAlignment="Right" Margin="0"
                                Click="CloseRulesCard_Click" />
                    </Grid>
                    <!-- Le panneau entier se réduit avec la fenêtre : les dix mains restent visibles sans défilement. -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                        <Grid Width="1010" Height="650">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#F3E6D1" BorderBrush="#B58C53" BorderThickness="2"
                                    CornerRadius="10" Padding="18"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="DÉROULEMENT" Foreground="#3E2721"
                                               FontSize="22" FontWeight="Bold" FontFamily="Georgia" />
                                    <TextBlock Text="Classez ensemble vos mains de la plus faible à la plus forte."
                                               Foreground="#49352A" FontSize="16" TextWrapping="Wrap"
                                               Margin="0,8,0,14" />
                                    <StackPanel x:Name="RuleRoundsPanel" />
                                    <TextBlock Text="RÉVÉLATION" Foreground="#622C24" FontSize="17"
                                               FontWeight="Bold" Margin="0,16,0,5" />
                                    <TextBlock Text="Après les jetons rouges, révélez les mains dans l'ordre 1, 2, 3… Une erreur dans le classement déclenche une alarme."
                                               Foreground="#49352A" TextWrapping="Wrap" FontSize="15" />
                                    <TextBlock Text="OUVRIR LE COFFRE" Foreground="#622C24" FontSize="17"
                                               FontWeight="Bold" Margin="0,16,0,5" />
                                    <TextBlock Text="Retournez trois cartes d'or pour gagner. Trois alarmes mettent fin à la partie."
                                               Foreground="#49352A" TextWrapping="Wrap" FontSize="15" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F3E6D1" BorderBrush="#B58C53"
                                    BorderThickness="2" CornerRadius="10" Padding="14" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CLASSEMENT DES MAINS" Foreground="#3E2721"
                                               FontSize="22" FontWeight="Bold" FontFamily="Georgia" />
                                    <TextBlock Text="De la plus forte à la plus faible"
                                               Foreground="#65493B" FontSize="16" Margin="0,4,0,8" />
                                    <StackPanel x:Name="PokerHandRowsPanel" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
