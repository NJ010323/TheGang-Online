                            <StackPanel x:Name="CommunityCardsPanel" Orientation="Horizontal"
                                        Canvas.Left="425" Canvas.Top="250" />
                            <TextBlock x:Name="TablePhaseText" Foreground="#E6C37D" FontSize="18"
                                       TextAlignment="Center" Width="660" Canvas.Left="310" Canvas.Top="408" />
                            <!-- Les jetons libres reposent sur le feutre, à portée de tous les joueurs. -->
                            <Canvas x:Name="TokenBankPanel" Width="1280" Height="720" />
                            <Canvas x:Name="SeatsCanvas" Width="1280" Height="720" />
                            <!-- Les deux piles de trois cartes sont communes à tous les joueurs. -->
                            <Border Canvas.Left="22" Canvas.Top="532" Width="250"
                                    CornerRadius="10" Background="#CC171518" BorderBrush="#A27C48"
                                    BorderThickness="1.5" Padding="9,6">
                                <StackPanel>
                                    <StackPanel IsHitTestVisible="False">
                                        <StackPanel x:Name="GoldResultCardsPanel" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" />
                                        <StackPanel x:Name="AlarmResultCardsPanel" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button x:Name="ReviewHeistButton" Content="↺  REVOIR LE DÉBRIEF"
                                            Visibility="Collapsed" Style="{StaticResource ScoreReviewButton}"
                                            Height="27" Margin="2,5,2,0" Click="ReviewHeist_Click"
                                            AutomationProperties.Name="Revoir le débrief du dernier braquage" />
                                </StackPanel>
                            </Border>
                            <!-- Une roue radiale : chaque action possède son propre tiers cliquable. -->
                            <Grid x:Name="TokenActionWheel" Width="220" Height="220" Visibility="Collapsed"
                                  Canvas.Left="300" Canvas.Top="480" Panel.ZIndex="3">
                                <Ellipse Width="214" Height="214" Fill="#E71A1418" Stroke="#D6A95F"
                                         StrokeThickness="3" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#090607" BlurRadius="15" ShadowDepth="4" Opacity="0.8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Button x:Name="ConfirmButton" Style="{StaticResource TokenWheelSectorButton}"
                                        Tag="{StaticResource ConfirmWheelSector}"
                                        Clip="{StaticResource ConfirmWheelSector}"
                                        Click="Confirm_Click"
                                        AutomationProperties.Name="Confirmer mon choix">
                                    <Canvas Width="220" Height="220" IsHitTestVisible="False">
                                        <StackPanel Canvas.Left="60" Canvas.Top="10" Width="100">
                                            <TextBlock Text="✓" Foreground="#F8D88D" FontSize="23"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="CONFIRMER" Foreground="#FFF1D1" FontSize="13"
                                                       FontWeight="Bold" TextAlignment="Center" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>
                                <Button x:Name="ReturnTokenButton" Style="{StaticResource TokenWheelSectorButton}"
                                        Tag="{StaticResource ReturnWheelSector}"
                                        Clip="{StaticResource ReturnWheelSector}"
                                        Click="ReturnToken_Click"
                                        AutomationProperties.Name="Rendre mon jeton">
                                    <Canvas Width="220" Height="220" IsHitTestVisible="False">
                                        <StackPanel Canvas.Left="12" Canvas.Top="121" Width="83">
                                            <TextBlock Text="↶" Foreground="#F5D188" FontSize="27"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="RENDRE" Foreground="#FFF1D1" FontSize="12"
                                                       FontWeight="Bold" TextAlignment="Center" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>
                                <Button x:Name="WithdrawButton" Style="{StaticResource TokenWheelSectorButton}"
                                        Tag="{StaticResource WithdrawWheelSector}"
                                        Clip="{StaticResource WithdrawWheelSector}"
                                        Click="Withdraw_Click"
                                        AutomationProperties.Name="Retirer ma confirmation">
                                    <Canvas Width="220" Height="220" IsHitTestVisible="False">
                                        <StackPanel Canvas.Left="125" Canvas.Top="121" Width="83">
                                            <TextBlock Text="×" Foreground="#F3AAA0" FontSize="29"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="RETIRER" Foreground="#FFF1D1" FontSize="12"
                                                       FontWeight="Bold" TextAlignment="Center" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>
                                <!-- L'anneau lumineux suit exactement le secteur de confirmation. -->
                                <Path x:Name="ConfirmCueRing" Data="{StaticResource ConfirmWheelSector}"
                                      Stroke="#FFF0AB" StrokeThickness="5" Opacity="0"
                                      Fill="Transparent" IsHitTestVisible="False" />
                                <Ellipse Width="86" Height="86" Fill="#291C20" Stroke="#D3A85E"
                                         StrokeThickness="2.5" IsHitTestVisible="False" />
                                <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="✦" Foreground="#E9C373" FontSize="19" TextAlignment="Center" />
                                    <TextBlock Text="VOTRE" Foreground="#D7B77D" FontSize="11"
                                               FontWeight="Bold" TextAlignment="Center" />
                                    <TextBlock Text="CHOIX" Foreground="#FFF0CA" FontSize="12"
                                               FontWeight="Bold" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <!-- Carte d'aide conservée à côté de la main du joueur local. -->
                            <Button x:Name="RulesCardButton" Canvas.Left="778" Canvas.Top="550"
                                    Width="128" Height="140" Cursor="Hand"
                                    AutomationProperties.Name="Agrandir la carte des règles"
                                    Click="OpenRules_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RulesFrame" CornerRadius="8" Background="#D6AC61"
                                                BorderBrush="#FFDB89" BorderThickness="2" Padding="3">
                                            <Border x:Name="RulesInset" CornerRadius="4" Background="#F4E7D0"
                                                    BorderBrush="#904B32" BorderThickness="1" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RulesFrame" Property="BorderBrush" Value="White" />
                                                <Setter TargetName="RulesInset" Property="Background" Value="#FFF2D9" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="RulesFrame" Property="BorderBrush" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Width="106">
                                    <TextBlock Text="✦  AIDE DE JEU  ✦" Foreground="#75322B" FontSize="11"
                                               FontWeight="Bold" TextAlignment="Center" />
                                    <Grid Height="56" Margin="0,2,0,1">
                                        <TextBlock Text="♠" Foreground="#251F26" FontSize="48"
                                                   TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="♥" Foreground="#B82432" FontSize="22"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,18,1" />
                                    </Grid>
                                    <TextBlock Text="10 COMBINAISONS" Foreground="#3D2924" FontSize="10"
                                               FontWeight="Bold" TextAlignment="Center" />
                                    <Border Height="22" Background="#69342B" CornerRadius="2"
                                            Margin="0,5,0,0">
                                        <TextBlock Text="AGRANDIR  ↗" Foreground="#FFE9C9" FontSize="10"
                                                   FontWeight="Bold" TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Canvas x:Name="ChipFlightCanvas" Width="1280" Height="720"
                                    IsHitTestVisible="False" />
                            <!-- L'annonce de phase reste sur le tapis pendant le retournement des cartes. -->
                            <Grid x:Name="RoundTransitionOverlay" Width="1280" Height="720"
                                  Visibility="Collapsed" IsHitTestVisible="False"
                                  Background="#760B0709">
                                <Border x:Name="RoundTransitionCard" Width="575" Padding="30,23"
                                        Background="#F21B1114" BorderBrush="#E5B958"
                                        BorderThickness="2" CornerRadius="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,100,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RoundTransitionScale" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="RoundTransitionEyebrow" Text="TOUR TERMINÉ"
                                                   TextAlignment="Center" Foreground="#D7B97A"
                                                   FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="RoundTransitionTitle" TextAlignment="Center"
                                                   FontFamily="Georgia" FontSize="31" FontWeight="Bold"
                                                   Foreground="#F6D17C" Margin="0,9,0,7" />
                                        <TextBlock x:Name="RoundTransitionDetail" TextAlignment="Center"
                                                   Foreground="#F0DFC6" FontSize="18" />
                                        <Border Height="5" Background="#594B372B" CornerRadius="3"
                                                Margin="0,20,0,0">
                                            <Border x:Name="RoundTransitionProgress" Background="#E5B958"
                                                    CornerRadius="3" HorizontalAlignment="Stretch"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="RoundTransitionProgressScale" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Viewbox>
                    <!-- La roue reste lisible même quand le tapis rétrécit ; elle suit la main locale. -->
                    <Grid x:Name="HostActions" Width="150" Height="150" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,400,12"
                          Panel.ZIndex="3">
                        <Button x:Name="AdvanceButton" Style="{StaticResource HostWheelButton}"
                                AutomationProperties.Name="Dévoiler le tour suivant"
                                Click="Advance_Click">
                            <StackPanel Width="112" HorizontalAlignment="Center">
                                <TextBlock Text="HÔTE" Foreground="#C9AB75" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock Text="♠" Foreground="#F4D182" FontSize="22"
                                           TextAlignment="Center" Margin="0,-2,0,-2" />
                                <TextBlock x:Name="AdvanceWheelVerb" Text="DÉVOILER" Foreground="#E5C482"
                                           FontSize="10" FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock x:Name="AdvanceWheelTitle" Text="LE FLOP" Foreground="#FFF1D0"
                                           FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RevealButton" Style="{StaticResource HostWheelButton}"
                                AutomationProperties.Name="Révéler la prochaine main"
                                Click="Reveal_Click">
                            <StackPanel Width="112" HorizontalAlignment="Center">
                                <TextBlock Text="HÔTE" Foreground="#C9AB75" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock Text="♠" Foreground="#F4D182" FontSize="22"
                                           TextAlignment="Center" Margin="0,-2,0,-2" />
                                <TextBlock Text="RÉVÉLER" Foreground="#E5C482" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock Text="MAIN SUIVANTE" Foreground="#FFF1D0" FontSize="13"
                                           FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResolveButton" Style="{StaticResource HostWheelButton}"
                                AutomationProperties.Name="Vérifier l'ordre des mains"
                                Click="Resolve_Click">
                            <StackPanel Width="112" HorizontalAlignment="Center">
                                <TextBlock Text="HÔTE" Foreground="#C9AB75" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock Text="♠" Foreground="#F4D182" FontSize="22"
                                           TextAlignment="Center" Margin="0,-2,0,-2" />
                                <TextBlock Text="VÉRIFIER" Foreground="#E5C482" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock Text="LES MAINS" Foreground="#FFF1D0" FontSize="14"
                                           FontWeight="Bold" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NextHeistButton" Style="{StaticResource HostWheelButton}"
                                AutomationProperties.Name="Lancer le braquage suivant"
                                Click="NextHeist_Click">
                            <StackPanel Width="112" HorizontalAlignment="Center">
                                <TextBlock Text="HÔTE" Foreground="#C9AB75" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock Text="♠" Foreground="#F4D182" FontSize="22"
                                           TextAlignment="Center" Margin="0,-2,0,-2" />
                                <TextBlock Text="LANCER" Foreground="#E5C482" FontSize="10"
                                           FontWeight="Bold" TextAlignment="Center" />
                                <TextBlock x:Name="NextHeistTitle" Text="BRAQUAGE SUIVANT"
                                           Foreground="#FFF1D0" FontSize="13" FontWeight="Bold"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    </Grid>
                </Border>
                <Border x:Name="HistoryPanel" Grid.Column="1" Background="#E3161012" BorderBrush="#806441"
                        BorderThickness="1" CornerRadius="10" Margin="12,0,0,0" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock Text="TABLEAU DES JETONS" FontSize="16" FontWeight="Bold"
                                           Foreground="#F0C86A" VerticalAlignment="Center" />
                                <Button x:Name="HistoryHideButton" Width="34" Height="30"
                                        HorizontalAlignment="Right" Padding="0"
                                        Style="{StaticResource HistoryTabButton}"
                                        AutomationProperties.Name="Masquer le tableau des jetons"
                                        Click="HistoryToggle_Click">
                                    <Path Data="M 3,2 L 9,8 L 3,14" Width="12" Height="16"
                                          Stroke="#F8EBD4" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Stretch="None" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Choix de chaque joueur, tour par tour"
                                       Foreground="#BBAE9C" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border x:Name="ActivityPanel" DockPanel.Dock="Bottom"
                                BorderBrush="#725636" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="ACTIONS RÉCENTES" FontSize="13" FontWeight="Bold"
                                           Foreground="#F0C86A" Margin="0,0,0,8" />
                                <StackPanel x:Name="ActivityRowsPanel" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Classement progressif des mains déjà dévoilées ; les autres attendent en bas. -->
                                <Border x:Name="ShowdownResultsPanel" Visibility="Collapsed"
                                        Background="#342023" BorderBrush="#AA7655" BorderThickness="1"
                                        CornerRadius="8" Padding="7" Margin="0,0,0,9">
                                    <StackPanel>
                                        <TextBlock Text="CLASSEMENT DES MAINS" Foreground="#F8D48A"
                                                   FontFamily="Georgia" FontSize="14" FontWeight="Bold"
                                                   Margin="1,1,0,2" />
                                        <TextBlock x:Name="ShowdownProgressText" Foreground="#BFA991"
                                                   FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Margin="1,0,0,6" />
                                        <StackPanel x:Name="ShowdownRowsPanel" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="HistorySubheading" Text="HISTORIQUE DES JETONS"
                                           Visibility="Collapsed" Foreground="#CBA665"
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />
                                <StackPanel x:Name="HistoryRowsPanel" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Button x:Name="HistoryShowButton" Grid.Column="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                        Visibility="Collapsed" Style="{StaticResource HistoryTabButton}"
                        AutomationProperties.Name="Afficher le tableau des jetons"
                        Click="HistoryToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 9,2 L 3,8 L 9,14" Width="12" Height="16"
                              Stroke="#F8EBD4" StrokeThickness="2" Margin="0,0,7,0"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="None" />
                        <TextBlock Text="Tableau des jetons" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="2" Height="68" BorderBrush="#9A7349"
                    BorderThickness="0,1.5,0,0" Padding="18,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#352020" Offset="0" />
                        <GradientStop Color="#1B1316" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Le bandeau décrit l'état ; les actions sont dans la roue près de la main. -->
                <Grid>
                    <Grid x:Name="TokenActions">
                        <TextBlock x:Name="TokenActionHint" Text="JETONS AU CENTRE · GLISSEZ VERS VOTRE MAIN"
                                   Foreground="#E9C575" VerticalAlignment="Center" TextAlignment="Center"
                                   FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock x:Name="FooterPhaseHint" TextAlignment="Center"
                               Foreground="#E9D5AE" FontSize="14" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

