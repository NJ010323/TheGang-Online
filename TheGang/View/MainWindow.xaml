<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Test Peer-to-Peer" Height="520" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Fenêtre de test Peer-to-Peer"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Hôte" Margin="0,0,8,0">
                <StackPanel Margin="12">
                    <TextBlock Text="Nom de l'hôte" />
                    <TextBox Margin="0,4,0,12"
                             Text="{Binding HostDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Port d'écoute" />
                    <TextBox Margin="0,4,0,12"
                             Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Nombre max de joueurs" />
                    <TextBox Margin="0,4,0,16"
                             Text="{Binding MaxPeers, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Démarrer l'hôte"
                                Width="140"
                                Margin="0,0,8,0"
                                Command="{Binding StartHostCommand}" />
                        <Button Content="Arrêter"
                                Width="80"
                                Command="{Binding StopHostCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Rejoindre une session" Grid.Column="1" Margin="8,0">
                <StackPanel Margin="12">
                    <TextBlock Text="Nom du joueur" />
                    <TextBox Margin="0,4,0,12"
                             Text="{Binding JoinDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Adresse de l'hôte" />
                    <TextBox Margin="0,4,0,12"
                             Text="{Binding JoinAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Port de l'hôte" />
                    <TextBox Margin="0,4,0,16"
                             Text="{Binding JoinPort, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Se connecter"
                                Width="140"
                                Margin="0,0,8,0"
                                Command="{Binding JoinCommand}" />
                        <Button Content="Se déconnecter"
                                Width="120"
                                Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Participants" Grid.Column="2" Margin="8,0,0,0">
                <StackPanel Margin="12">
                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,0"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="L'hôte verra les joueurs connectés ici." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Relais (pour jouer entre réseaux différents)" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <StackPanel Margin="12">
                    <CheckBox Content="Utiliser un relais" IsChecked="{Binding UseRelay}" />
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Adresse du relais" />
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding RelayAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Port du relais" />
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding RelayPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Code de session" />
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding RelaySessionCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="Le relais permet aux joueurs sur des réseaux différents de se connecter sans ouvrir de ports." />
                </StackPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Background="#FFF5F5F5" Padding="12">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
