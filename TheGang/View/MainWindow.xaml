<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Test Peer-to-Peer" Height="720" Width="980" MinHeight="640" MinWidth="960" Background="#FFF8F8F8">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,2" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Fenêtre de test Peer-to-Peer"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Hôte" Margin="0,0,12,0">
                <StackPanel Margin="12">
                    <TextBlock Text="Nom de l'hôte" />
                    <TextBox Text="{Binding HostDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Port d'écoute" />
                    <TextBox Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Nombre max de joueurs" />
                    <TextBox Margin="0,4,0,16"
                             Text="{Binding MaxPeers, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Démarrer l'hôte"
                                Width="140"
                                Margin="0,0,8,0"
                                Command="{Binding StartHostCommand}" />
                        <Button Content="Arrêter"
                                Width="80"
                                Command="{Binding StopHostCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Rejoindre une session" Grid.Column="1" Margin="0,0,12,0">
                <StackPanel Margin="12">
                    <TextBlock Text="Nom du joueur" />
                    <TextBox Text="{Binding JoinDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Adresse de l'hôte" />
                    <TextBox Text="{Binding JoinAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Port de l'hôte" />
                    <TextBox Margin="0,4,0,16"
                             Text="{Binding JoinPort, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Se connecter"
                                Width="140"
                                Margin="0,0,8,0"
                                Command="{Binding JoinCommand}" />
                        <Button Content="Se déconnecter"
                                Width="120"
                                Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Participants" Grid.Column="2">
                <StackPanel Margin="12">
                    <ListBox ItemsSource="{Binding Peers}" MinHeight="160" />
                    <TextBlock Margin="0,12,0,0"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="L'hôte verra les joueurs connectés ici." />
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Chat de session" Margin="0,8,0,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding ChatMessages}"
                         Background="#FFFDFDFD"
                         BorderBrush="#FFE2E2E2" />

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0"
                             MinHeight="34"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Envoyer"
                            Margin="8,0,0,0"
                            Command="{Binding SendChatCommand}" />
                </Grid>
            </Grid>
        </GroupBox>

        <Border Grid.Row="3" Margin="0,8,0,0" Background="#FFF1F1F1" Padding="12" CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
