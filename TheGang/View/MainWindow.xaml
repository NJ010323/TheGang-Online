                <RowDefinition Height="51" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="22,3,22,5">
                <Grid>
                    <TextBlock x:Name="GamePhaseText" FontSize="21" FontFamily="Georgia" FontWeight="Bold"
                               Foreground="#F0C86A" VerticalAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Left" MaxWidth="370" />
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="HistoryColumn" Width="306" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#806441" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid x:Name="TableSurface">
                    <Viewbox Stretch="Uniform">
