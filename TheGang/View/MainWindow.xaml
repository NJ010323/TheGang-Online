<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:View"
        Title="The Gang" Icon="Assets/app-icon.png" Width="1440" Height="900" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0D0909" Foreground="#F8EDD9"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp" LostMouseCapture="Window_LostMouseCapture">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E5B958" />
            <Setter Property="Foreground" Value="#22130F" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="#FFF0CE84" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#FFE3A2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#332A25" />
            <Setter Property="Foreground" Value="#F6E9CF" />
        </Style>
        <!-- Commandes du plateau : même cadre art déco, couleurs distinctes selon l'action. -->
        <Style x:Key="TableButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#453034" Offset="0" />
                        <GradientStop Color="#281B20" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#A98557" />
            <Setter Property="Foreground" Value="#F8EBD4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverWash" Background="#88FFF2D6"
                                        CornerRadius="8" Opacity="0" />
                                <Border Margin="3" CornerRadius="6" BorderBrush="#695F4440"
                                        BorderThickness="0.6" IsHitTestVisible="False" />
                                <Border Height="1" Margin="10,3,10,0" VerticalAlignment="Top"
                                        Background="#7EFFE9AD" />
                                <Border Height="1" Margin="10,0,10,3" VerticalAlignment="Bottom"
                                        Background="#85200E12" />
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◆" FontSize="7" Opacity="0.7" Margin="0,0,8,0"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                    <TextBlock Grid.Column="2" Text="◆" FontSize="7" Opacity="0.7"
                                               Margin="8,0,0,0" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.24" />
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#FFE3A3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.36" />
                                <Setter TargetName="ButtonShell" Property="Margin" Value="0,1,0,-1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableActionButton" TargetType="Button" BasedOn="{StaticResource TableButton}">
            <Setter Property="Foreground" Value="#29160F" />
            <Setter Property="BorderBrush" Value="#FFE2A0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F7DB91" Offset="0" />
                        <GradientStop Color="#D9A34D" Offset="0.56" />
                        <GradientStop Color="#B98339" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Appel à prendre la relève : même cadre que les commandes de table, avec un accent d'or. -->
        <Style x:Key="MigrationAcceptButton" TargetType="Button" BasedOn="{StaticResource TableActionButton}">
            <Setter Property="Width" Value="218" />
            <Setter Property="Height" Value="60" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#F0B65D" BlurRadius="15" ShadowDepth="0" Opacity="0.38" />
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Trois arcs de 120° : une seule roue avec des cibles qui épousent chaque secteur. -->
        <PathGeometry x:Key="ConfirmWheelSector" Figures="M 21.7,59 A 102,102 0 0 1 198.3,59 L 147.2,88.5 A 43,43 0 0 0 72.8,88.5 Z" />
        <PathGeometry x:Key="ReturnWheelSector" Figures="M 110,212 A 102,102 0 0 1 21.7,59 L 72.8,88.5 A 43,43 0 0 0 110,153 Z" />
        <PathGeometry x:Key="WithdrawWheelSector" Figures="M 198.3,59 A 102,102 0 0 1 110,212 L 110,153 A 43,43 0 0 0 147.2,88.5 Z" />
        <Style x:Key="TokenWheelSectorButton" TargetType="Button">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="220" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="220" Height="220">
                            <Path x:Name="SectorFace" Data="{TemplateBinding Tag}" Fill="#37272B"
                                  Stroke="#D2A85F" StrokeThickness="2.5" />
                            <ContentPresenter x:Name="SectorContent" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SectorFace" Property="Fill" Value="#705039" />
                                <Setter TargetName="SectorFace" Property="Stroke" Value="#FFE4A2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SectorFace" Property="Fill" Value="#9C683C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SectorFace" Property="Stroke" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SectorFace" Property="Fill" Value="#2A2327" />
                                <Setter TargetName="SectorFace" Property="Stroke" Value="#786344" />
                                <Setter TargetName="SectorContent" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- La roue de phase reste réservée à l'hôte une fois les choix confirmés. -->
        <Style x:Key="HostWheelButton" TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="WheelShell" Width="150" Height="150">
                            <Ellipse Fill="#EF211719" Stroke="#D9AB5A" StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#110706" BlurRadius="16" ShadowDepth="4" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="7" Stroke="#7CC89D55" StrokeThickness="1"
                                     StrokeDashArray="2 5" IsHitTestVisible="False" />
                            <Ellipse x:Name="WheelFace" Margin="14" Stroke="#9FAD783F"
                                     StrokeThickness="1.5" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#623E2D" Offset="0" />
                                        <GradientStop Color="#3A2426" Offset="0.7" />
                                        <GradientStop Color="#291B20" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter Margin="18" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WheelFace" Property="Stroke" Value="#FFE7A0" />
                                <Setter TargetName="WheelShell" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WheelShell" Property="Margin" Value="0,2,0,-2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="WheelFace" Property="Stroke" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="WheelShell" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableDangerButton" TargetType="Button" BasedOn="{StaticResource TableButton}">
            <Setter Property="Foreground" Value="#F7D4CA" />
            <Setter Property="BorderBrush" Value="#B66B61" />
            <Setter Property="Background" Value="#4A2024" />
        </Style>
        <!-- Petite commande utilisée sur le bord du tableau des jetons. -->
        <Style x:Key="HistoryTabButton" TargetType="Button">
            <Setter Property="Background" Value="#302326" />
            <Setter Property="Foreground" Value="#F8EBD4" />
            <Setter Property="BorderBrush" Value="#A98557" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="#503438" />
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#F0C86A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Commande compacte intégrée au support des cartes de résultat. -->
        <Style x:Key="ScoreReviewButton" TargetType="Button" BasedOn="{StaticResource HistoryTabButton}">
            <Setter Property="Background" Value="#392629" />
            <Setter Property="Foreground" Value="#F8D995" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="EntryBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1414" />
            <Setter Property="Foreground" Value="#FFF4DF" />
            <Setter Property="CaretBrush" Value="#F0C86A" />
            <Setter Property="SelectionBrush" Value="#D4A64D" />
            <Setter Property="BorderBrush" Value="#967347" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,7,0,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputFrame" Property="BorderBrush" Value="#F4C969" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputFrame" Property="Background" Value="#2B2020" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Boutons segmentés partagés par la capacité du lobby et les paramètres. -->
        <Style x:Key="SelectionChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F4E5CA" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceFrame" Background="#2A1D1C" BorderBrush="#8C6943"
                                BorderThickness="1.5" CornerRadius="9" Padding="13,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#F1C66A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="Background" Value="#E5B958" />
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#FFDF89" />
                                <Setter Property="Foreground" Value="#21130E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceFrame" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête sobre, inspiré du cartouche doré de la boîte. -->
        <Grid Grid.Row="0" Background="#080707">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/logo-reference.png" Width="184" Height="58" Stretch="None"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Width="62" Height="1" Background="#8B6231" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="✦" Foreground="#D8AF5D" FontSize="14" VerticalAlignment="Center" />
                <Border Width="62" Height="1" Background="#8B6231" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="⚙  Paramètres" AutomationProperties.Name="Ouvrir les paramètres"
                    Style="{StaticResource TableButton}" Margin="0,12,18,2" Click="Settings_Click" />
        </Grid>

        <!-- Menu principal. -->
        <Grid x:Name="MenuPanel" Grid.Row="1">
            <Image Source="Assets/table-felt.png" Stretch="UniformToFill" Opacity="0.72" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#EC100A0B" Offset="0" />
                        <GradientStop Color="#A5100A0B" Offset="0.55" />
                        <GradientStop Color="#25100A0B" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Margin="80,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="530" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="530" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="UN BRAQUAGE. UNE SEULE ÉQUIPE." Foreground="#F0C86A"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />
                    <TextBlock Text="Lisez vos cartes.&#10;Classez vos forces.&#10;Gagnez ensemble."
                               FontSize="38" FontFamily="Georgia" FontWeight="Bold" LineHeight="50"
                               TextWrapping="Wrap" Margin="0,0,0,20" />
                    <TextBlock Text="De 3 à 6 joueurs. Créez un lobby, partagez l'invitation et prenez place autour de la table."
                               Foreground="#DFD0BC" FontSize="17" TextWrapping="Wrap" Width="465"
                               HorizontalAlignment="Left" Margin="0,0,0,22" />
                    <Button Content="Héberger une partie" Width="270" HorizontalAlignment="Left"
                            Style="{StaticResource ActionButton}" Margin="0,0,0,7" Click="HostMenu_Click" />
                    <Button Content="Rejoindre une partie" Width="270" HorizontalAlignment="Left"
                            Style="{StaticResource QuietButton}" Margin="0,0,0,7" Click="JoinMenu_Click" />
                    <Button x:Name="ResumeButton" Content="Reprendre ma partie" Width="270"
                            HorizontalAlignment="Left" Visibility="Collapsed"
                            Style="{StaticResource ActionButton}" Margin="0,0,0,7" Click="Resume_Click" />
                    <Button Content="Règles du jeu" Width="270" HorizontalAlignment="Left"
                            AutomationProperties.Name="Afficher les règles du jeu"
                            Style="{StaticResource QuietButton}" Margin="0,0,0,7" Click="OpenRules_Click" />
                    <Button Content="Quitter le jeu" Width="270" HorizontalAlignment="Left"
                            Style="{StaticResource QuietButton}" Margin="0,0,0,7" Click="Quit_Click" />
                </StackPanel>
                <!-- Éventail décoratif : cinq faces aléatoires et deux dos, réduits ensemble sur les petits écrans. -->
                <Viewbox Grid.Column="1" MaxWidth="600" MaxHeight="540" Margin="20,0,0,0"
                         Stretch="Uniform" StretchDirection="DownOnly" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas x:Name="MenuCardsCanvas" Width="600" Height="540" />
                </Viewbox>
            </Grid>
        </Grid>

        <!-- Choix hôte/invité avant ouverture de la connexion. -->
        <Grid x:Name="EntryPanel" Grid.Row="1" Visibility="Collapsed">
            <Image Source="Assets/table-felt.png" Stretch="UniformToFill" Opacity="0.36" />
            <Border Width="560" Padding="40" Background="#E9161012" BorderBrush="#8B7048"
                    BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EntryTitle" Text="Héberger une partie" FontSize="31"
                               FontFamily="Georgia" FontWeight="Bold" Foreground="#F6D17C" Margin="0,0,0,9" />
                    <TextBlock x:Name="EntrySubtitle" Text="Choisissez votre pseudo et la taille de la table."
                               Foreground="#CFC0A9" FontSize="15" Margin="0,0,0,30" />
                    <TextBlock Text="VOTRE PSEUDO" Foreground="#E0C78A" FontWeight="SemiBold" />
                    <TextBox x:Name="NicknameBox" Style="{StaticResource EntryBox}" MaxLength="24" />
                    <StackPanel x:Name="HostSetup">
                        <TextBlock Text="NOMBRE MAXIMAL DE JOUEURS" Foreground="#E0C78A" FontWeight="SemiBold" />
                        <TextBlock Text="Choisissez la taille de la table, hôte compris."
                                   Foreground="#BBAE9C" FontSize="13" Margin="0,5,0,12" />
                        <UniformGrid Columns="4" Margin="0,0,0,25">
                            <RadioButton x:Name="Players3Option" Content="3" GroupName="LobbyCapacity"
                                         IsChecked="True" Style="{StaticResource SelectionChoice}" />
                            <RadioButton x:Name="Players4Option" Content="4" GroupName="LobbyCapacity"
                                         Style="{StaticResource SelectionChoice}" />
                            <RadioButton x:Name="Players5Option" Content="5" GroupName="LobbyCapacity"
                                         Style="{StaticResource SelectionChoice}" />
                            <RadioButton x:Name="Players6Option" Content="6" GroupName="LobbyCapacity"
                                         Style="{StaticResource SelectionChoice}" />
                        </UniformGrid>
                        <Button x:Name="CreateButton" Content="Créer le lobby" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Width="230" Click="Create_Click" />
                    </StackPanel>
                    <StackPanel x:Name="JoinSetup" Visibility="Collapsed">
                        <TextBlock Text="INVITATION REÇUE" Foreground="#E0C78A" FontWeight="SemiBold" />
                        <TextBox x:Name="InvitationInput" Style="{StaticResource EntryBox}" />
                        <Button x:Name="JoinButton" Content="Rejoindre la table" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Width="230" Click="Join_Click" />
                    </StackPanel>
                    <Button Content="← Retour au menu" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Margin="0,22,0,0" Click="BackMenu_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lobby avant départ. -->
        <Grid x:Name="LobbyPanel" Grid.Row="1" Visibility="Collapsed">
            <Image Source="Assets/table-felt.png" Stretch="UniformToFill" Opacity="0.43" />
            <Grid Margin="60,35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,35,0">
                    <TextBlock Text="SALON DE JEU" Foreground="#E6BF69" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="En attente des joueurs" FontSize="36" FontFamily="Georgia"
                               FontWeight="Bold" Margin="0,10,0,20" />
                    <TextBlock x:Name="LobbyDetails" FontSize="18" Foreground="#E7D6B9"
                               TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Border x:Name="LobbyCapacityPanel" Visibility="Collapsed" Margin="0,0,0,20"
                            Padding="14,12" Background="#D91C1414" BorderBrush="#A8844C"
                            BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="PLACES À LA TABLE" Foreground="#F0C86A"
                                           FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="Modifiables avant la distribution"
                                           Foreground="#C6B49B" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Width="224" Rows="1" Columns="4"
                                         HorizontalAlignment="Right" VerticalAlignment="Center">
                                <RadioButton x:Name="LobbyPlayers3Option" Content="3" Tag="3"
                                             GroupName="OpenLobbyCapacity" Style="{StaticResource SelectionChoice}"
                                             Click="LobbyCapacity_Click" />
                                <RadioButton x:Name="LobbyPlayers4Option" Content="4" Tag="4"
                                             GroupName="OpenLobbyCapacity" Style="{StaticResource SelectionChoice}"
                                             Click="LobbyCapacity_Click" />
                                <RadioButton x:Name="LobbyPlayers5Option" Content="5" Tag="5"
